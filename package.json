{
  "name": "bike-auction",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @bike/web build && pnpm --filter @bike/worker db:migrate:local && pnpm --filter @bike/worker dev",
    "dev:web": "pnpm --filter @bike/web dev",
    "build": "pnpm --filter @bike/web build && pnpm --filter @bike/worker build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:migrate:local": "pnpm --filter @bike/worker db:migrate:local",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "deploy": "node scripts/deploy.mjs",
    "gate:auth": "node scripts/auth-gate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
