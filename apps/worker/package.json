{
  "name": "@bike/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/ensure-assets.mjs && vitest run",
    "cf-typegen": "wrangler types --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "spike:auth": "node scripts/spike-auth-cpu.mjs"
  },
  "dependencies": {
    "@bike/contracts": "workspace:*",
    "@bike/domain": "workspace:*",
    "better-auth": "1.7.7",
    "hono": "4.13.13",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@noble/hashes": "2.4.0",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
