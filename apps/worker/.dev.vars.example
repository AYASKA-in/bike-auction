# Local development overrides (copied to .dev.vars by `pnpm dev`; never commit .dev.vars).
ENVIRONMENT=development
APP_VERSION=dev
ALLOWED_ORIGINS=http://localhost:8787,http://localhost:5173,http://127.0.0.1:8787
# 32+ random chars. Local only; production uses `wrangler secret put BETTER_AUTH_SECRET`.
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef
# Cloudflare's documented Turnstile TEST keys (always pass). Real keys are set at deploy time.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Per-auction bidder pseudonyms (HMAC key, 32+ chars). Production: wrangler secret.
PSEUDONYM_SECRET=local-pseudonym-secret-change-me-0123456789
SEED_TOKEN=local-seed-token-0123456789abcdef
