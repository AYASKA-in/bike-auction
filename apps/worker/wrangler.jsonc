{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bike-auction",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: Better Auth resolves the "workerd" export condition to node:crypto scrypt.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // SPA + API on one origin: /api/* always hits the Worker, everything else is static assets
  // with SPA fallback to index.html.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  "durable_objects": {
    "bindings": [
      { "name": "AUCTION", "class_name": "AuctionDO" },
      { "name": "PASSWORD_HASHER", "class_name": "PasswordHasherDO" },
      // Day-1 spike only (interleaving demonstration). Remove with a deleted_classes migration.
      { "name": "SPIKE_PROBE", "class_name": "SpikeProbeDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AuctionDO", "PasswordHasherDO", "SpikeProbeDO"] },
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bike-auction",
      // Placeholder for local development. Replace with the id printed by
      // `wrangler d1 create bike-auction` before the first deploy (see README → Deployment).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Bike images. If R2 is not enabled on the account, scripts/deploy.mjs deploys without this binding
  // and image upload answers 503 (listings show placeholders). See README → Deployment.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "bike-auction-images" }],
  // Free-plan fallback for photos when R2 is not enabled (src/lib/image-store.ts). The deploy script
  // creates the namespace and fills in its id; this placeholder id is only used locally.
  "kv_namespaces": [{ "binding": "PHOTOS", "id": "00000000000000000000000000000000" }],

  // Metrics (BLUEPRINT §10). Workers Analytics Engine is available on the free plan and is not
  // billed; the dataset is created on first write. Optional at runtime: unbound → metrics no-op.
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "bike_auction_metrics" }],
  // Daily data-retention purge (src/lib/retention.ts) at 21:47 UTC = 03:17 IST, off-peak.
  // Cron Triggers are included in the Free plan.
  "triggers": { "crons": ["47 21 * * *"] },

  // Coarse, per-location, eventually consistent edge limits (BLUEPRINT §7.5).
  // Key prefixes per use and the full endpoint table: docs/threat-model.md → Rate limits.
  "ratelimits": [
    { "name": "AUTH_RATE_LIMIT", "namespace_id": "4101", "simple": { "limit": 20, "period": 60 } },
    // Coarse per-user bid limit at the edge; the exact per-auction throttle lives in AuctionDO.
    { "name": "BID_RATE_LIMIT", "namespace_id": "4102", "simple": { "limit": 30, "period": 10 } },
  ],

  // Top-level config is PRODUCTION-SAFE by default. Local development overrides these values in
  // .dev.vars (created from .dev.vars.example by `pnpm dev`). Secrets: see src/env.d.ts.
  "vars": {
    "ENVIRONMENT": "production",
    "APP_VERSION": "unversioned",
    "ALLOWED_ORIGINS": "",
    // Public Turnstile site key. Replace with your widget's key (deploy script does this).
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    // Shows the public reviewer demo accounts on the sign-in page.
    "DEMO_MODE": "true",
    // Retention periods (src/lib/retention.ts, docs/privacy.md). Invalid values fall back to the
    // defaults; security logs can't go below 365 days.
    "RETENTION_SECURITY_EVENTS_DAYS": "365",
    "RETENTION_WATCHLIST_AFTER_END_DAYS": "90",
    "RETENTION_LOGIN_THROTTLE_HOURS": "24",
    "RETENTION_ACCOUNT_DELETIONS_DAYS": "365",
    "RETENTION_ORPHAN_UPLOAD_HOURS": "24",
  },
}
